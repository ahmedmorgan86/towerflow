# Server only; never commit real values.
# Firebase / Google Cloud SQL PostgreSQL (project: heroic-psyche-512522-v8) or Neon URL:
# Example: postgres://towerflow:your_password@<CLOUD_SQL_IP>:5432/towerflow?sslmode=require
DATABASE_URL=

# Google Cloud SQL socket connection (when deployed on GCP / Cloud Run / App Engine)
# CLOUDSQL_CONNECTION_NAME=heroic-psyche-512522-v8:europe-west1:towerflow-db

APP_ORIGIN=http://localhost:3000
PORT=3000

# Google login: server-side OAuth credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PLATFORM_OWNER_EMAIL=ahmed.morgan2009@gmail.com

# Firebase Project Credentials (heroic-psyche-512522-v8)
FIREBASE_PROJECT_ID=heroic-psyche-512522-v8
FIREBASE_SERVICE_ACCOUNT=

# Camera encryption: exactly 64 hexadecimal characters (32 random bytes).
# Keep outside Git, back up securely; changing it requires re-encrypting saved devices.
CAMERA_ENCRYPTION_KEY=
# Property UUID -> trusted HTTPS gateway origin and private bearer token.
# Example structure only: {"property-uuid":{"origin":"https://gateway.example.com","token":"..."}}
CAMERA_GATEWAYS={}
