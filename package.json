{
  "name": "towerflow",
  "version": "0.8.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local server.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "db:setup": "node --env-file-if-exists=.env.local scripts/database.mjs",
    "db:firebase": "node --env-file-if-exists=.env.local scripts/firebase-cloudsql.mjs",
    "db:cloudsql": "node --env-file-if-exists=.env.local scripts/firebase-cloudsql.mjs",
    "db:export": "node scripts/export-local-db.mjs",
    "local": "node scripts/local.mjs"
  },
  "dependencies": {
    "@vercel/functions": "3.10.3",
    "google-auth-library": "^10.3.0",
    "hls.js": "1.7.4",
    "pg": "8.16.3",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11"
  }
}
